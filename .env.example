# Exemplo de configuração de ambiente (SGFrotas-Facul - VeloceTech)
# Copie este arquivo para .env e preencha os dados do seu projeto Supabase da faculdade.

# --- PostgreSQL / Supabase (Session Pooler ou Direct Connection) ---
POSTGRES_HOST=aws-0-sa-east-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.SEU_PROJECT_REF
POSTGRES_PASSWORD=SUA_SENHA_SUPABASE
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=require

# --- Supabase API (Opcional para Storage/Auth) ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://SEU_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- Integração Combustível REST (Opcional - Contingência ativa se vazio) ---
VALECARD_BASE_URL=https://kissapi.valecard.com.br/core/services/frotaCliente
VALECARD_API_TOKEN=
VALECARD_CONTRATO_CLIENTE=
VALECARD_TIMEOUT_SECONDS=30
