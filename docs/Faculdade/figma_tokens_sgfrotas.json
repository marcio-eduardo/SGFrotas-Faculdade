{
  "$schema": "https://tokens.studio/schemas/token-set.json",
  "name": "SGFrotas Clean Light Design Tokens",
  "version": "2.0.0",
  "description": "Tokens de Design System oficiais do SGFrotas no Padrão Claro Executivo (Light Theme) para importação no Figma",
  "global": {
    "color": {
      "brand": {
        "50": { "value": "#f0f9ff", "type": "color", "description": "Azul gelo muito claro para fundos e seleções sutis" },
        "100": { "value": "#e0f2fe", "type": "color" },
        "200": { "value": "#bae6fd", "type": "color" },
        "300": { "value": "#7dd3fc", "type": "color" },
        "400": { "value": "#38bdf8", "type": "color" },
        "500": { "value": "#0ea5e9", "type": "color", "description": "Cyan elétrico de destaque e foco" },
        "600": { "value": "#0284c7", "type": "color", "description": "Azul petróleo corporativo principal de frota" },
        "700": { "value": "#0369a1", "type": "color" },
        "800": { "value": "#075985", "type": "color" },
        "900": { "value": "#0c4a6e", "type": "color" }
      },
      "surface": {
        "canvas": { "value": "#eef2f6", "type": "color", "description": "Fundo da prancheta do Figma / Canvas panorâmico" },
        "background": { "value": "#f8fafc", "type": "color", "description": "Fundo de página limpo e suave (Slate 50)" },
        "card": { "value": "#ffffff", "type": "color", "description": "Superfície de cards e painéis em branco puro" },
        "subtle": { "value": "#f1f5f9", "type": "color", "description": "Containers secundários e inputs (Slate 100)" },
        "border": { "value": "#e2e8f0", "type": "color", "description": "Borda divisória nítida e elegante (Slate 200)" },
        "borderLight": { "value": "#f1f5f9", "type": "color" }
      },
      "feedback": {
        "success": {
          "bg": { "value": "#ecfdf5", "type": "color", "description": "Fundo suave verde pastel" },
          "border": { "value": "#a7f3d0", "type": "color" },
          "text": { "value": "#065f46", "type": "color", "description": "Veículo Disponível / Auditoria Aprovada" },
          "main": { "value": "#10b981", "type": "color" }
        },
        "warning": {
          "bg": { "value": "#fffbeb", "type": "color", "description": "Fundo suave âmbar pastel" },
          "border": { "value": "#fde68a", "type": "color" },
          "text": { "value": "#92400e", "type": "color", "description": "Revisão Próxima (<2.000km) / Modo Offline" },
          "main": { "value": "#f59e0b", "type": "color" }
        },
        "danger": {
          "bg": { "value": "#fef2f2", "type": "color", "description": "Fundo suave vermelho pastel" },
          "border": { "value": "#fecaca", "type": "color" },
          "text": { "value": "#991b1b", "type": "color", "description": "Alerta Anti-Fraude / Multa NIC Crítica (<5 dias)" },
          "main": { "value": "#ef4444", "type": "color" }
        },
        "info": {
          "bg": { "value": "#eff6ff", "type": "color", "description": "Fundo suave azul pastel" },
          "border": { "value": "#bfdbfe", "type": "color" },
          "text": { "value": "#1e40af", "type": "color", "description": "Veículo Em Cautela Ativa" },
          "main": { "value": "#3b82f6", "type": "color" }
        }
      },
      "text": {
        "title": { "value": "#0f172a", "type": "color", "description": "Slate 900 de alto contraste para títulos" },
        "body": { "value": "#475569", "type": "color", "description": "Slate 600 para textos corridos" },
        "muted": { "value": "#64748b", "type": "color", "description": "Slate 500 para legendas e metadados" }
      }
    },
    "spacing": {
      "0": { "value": "0px", "type": "spacing" },
      "1": { "value": "4px", "type": "spacing" },
      "2": { "value": "8px", "type": "spacing" },
      "3": { "value": "12px", "type": "spacing" },
      "4": { "value": "16px", "type": "spacing" },
      "5": { "value": "20px", "type": "spacing" },
      "6": { "value": "24px", "type": "spacing" },
      "8": { "value": "32px", "type": "spacing" },
      "10": { "value": "40px", "type": "spacing" },
      "12": { "value": "48px", "type": "spacing" }
    },
    "borderRadius": {
      "none": { "value": "0px", "type": "borderRadius" },
      "sm": { "value": "6px", "type": "borderRadius" },
      "md": { "value": "8px", "type": "borderRadius" },
      "lg": { "value": "12px", "type": "borderRadius" },
      "xl": { "value": "16px", "type": "borderRadius", "description": "Cards internos, inputs e botões de ação" },
      "2xl": { "value": "20px", "type": "borderRadius", "description": "Cards principais, painéis e modais" },
      "3xl": { "value": "24px", "type": "borderRadius" },
      "full": { "value": "9999px", "type": "borderRadius", "description": "Pílulas de status e contadores" }
    },
    "typography": {
      "fontFamily": {
        "sans": { "value": "Inter, system-ui, -apple-system, sans-serif", "type": "fontFamilies" },
        "mono": { "value": "JetBrains Mono, monospace", "type": "fontFamilies", "description": "Placas, odômetros e valores monetários" }
      },
      "fontSize": {
        "2xs": { "value": "10px", "type": "fontSizes" },
        "xs": { "value": "12px", "type": "fontSizes" },
        "sm": { "value": "14px", "type": "fontSizes" },
        "base": { "value": "16px", "type": "fontSizes" },
        "lg": { "value": "18px", "type": "fontSizes" },
        "xl": { "value": "20px", "type": "fontSizes" },
        "2xl": { "value": "24px", "type": "fontSizes" },
        "3xl": { "value": "30px", "type": "fontSizes" }
      }
    },
    "elevation": {
      "card": {
        "value": {
          "x": "0",
          "y": "1",
          "blur": "3",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.05)",
          "type": "dropShadow"
        },
        "type": "boxShadow"
      },
      "modal": {
        "value": {
          "x": "0",
          "y": "20",
          "blur": "25",
          "spread": "-5",
          "color": "rgba(0, 0, 0, 0.1)",
          "type": "dropShadow"
        },
        "type": "boxShadow"
      }
    }
  }
}
